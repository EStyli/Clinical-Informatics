let currentIdx=0, phase='pre', timerInterval=null, timeLeft=0, totalTime=0;
const done=new Set();
let filterModule='all';

function modClass(m){return MOD_STYLES[m]||'ds'}

function buildHome(){
  const list=document.getElementById('scList');
  list.innerHTML='';
  const filtered=SCENARIOS.filter((_,i)=>{
    if(filterModule==='all')return true;
    return SCENARIOS[i].module===filterModule;
  });
  SCENARIOS.forEach((sc,i)=>{
    const isDone=done.has(i);
    const cls=modClass(sc.module);
    const show=filterModule==='all'||sc.module===filterModule;
    const card=document.createElement('div');
    card.className='sc-card'+(show?'':' hidden');
    card.innerHTML=`
      <div class="sc-num${isDone?' done':''}">${isDone?'✓':(i+1)}</div>
      <div class="sc-body">
        <div class="sc-title">${sc.title}</div>
        <div class="sc-meta">
          <span class="mod-tag" style="background:var(--${cls}-bg);color:var(--${cls})">${sc.module}</span>
          ${sc.tip?`<span class="sc-note" style="color:var(--${cls})">${sc.tip}</span>`:''}
          ${isDone?'<span class="sc-note" style="color:var(--station)">Completed</span>':''}
        </div>
      </div>
      <span class="sc-arrow">→</span>`;
    card.onclick=()=>startStation(i);
    list.appendChild(card);
  });
  document.getElementById('doneBadge').textContent=done.size+' / 13 done';
}

function buildFilters(){
  const row=document.getElementById('filterRow');
  const modules=['all',...Object.keys(MOD_STYLES)];
  modules.forEach(m=>{
    const chip=document.createElement('button');
    chip.className='fchip'+(m==='all'?' active':'');
    chip.textContent=m==='all'?'All modules':m;
    chip.onclick=()=>{
      filterModule=m;
      document.querySelectorAll('.fchip').forEach(c=>c.classList.remove('active'));
      chip.classList.add('active');
      buildHome();
    };
    row.appendChild(chip);
  });
}

function showView(id){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  document.getElementById('navHomeBtn').style.display=id==='homeView'?'none':'block';
  window.scrollTo(0,0);
}

function startStation(idx){
  currentIdx=idx;
  const sc=SCENARIOS[idx];
  const cls=modClass(sc.module);
  document.getElementById('scNumLabel').textContent=idx+1;
  document.getElementById('scModTag').textContent=sc.module;
  document.getElementById('scModTag').style.background='var(--'+cls+'-bg)';
  document.getElementById('scModTag').style.color='var(--'+cls+')';
  document.getElementById('scText').textContent=sc.text;
  const qi=document.getElementById('qItems');
  qi.innerHTML='';
  sc.qs.forEach((q,i)=>{
    const d=document.createElement('div');
    d.className='q-item';
    d.innerHTML=`<span class="q-n">${i+1}.</span><span>${q}</span>`;
    qi.appendChild(d);
  });
  const hp=document.getElementById('hintsPanel');
  hp.innerHTML='';
  sc.hints.forEach(h=>{
    const r=document.createElement('div');r.className='hint-row';r.textContent=h;
    hp.appendChild(r);
  });
  hp.style.display='none';
  document.getElementById('hintsToggleBtn').textContent='Show curriculum pointers ↓';
  setPhase('pre');
  showView('stationView');
}

