  phase=p;
  if(timerInterval)clearInterval(timerInterval);
  const pill=document.getElementById('phasePill');
  const note=document.getElementById('phaseNote');
  const btn=document.getElementById('mainBtn');
  const fill=document.getElementById('progressFill');
  if(p==='pre'){
    timeLeft=180;totalTime=180;
    pill.textContent='Reading time';pill.className='phase-pill reading';
    fill.className='progress-fill reading';
    note.textContent='3 minutes to read the scenario and questions. The station will begin automatically when reading time ends. You can skip ahead when ready.';
    btn.textContent='Skip to station →';
  } else {
    timeLeft=540;totalTime=540;
    pill.textContent='Station';pill.className='phase-pill station';
    fill.className='progress-fill station';
    note.textContent='Provide your response to the assessor. You can revisit the pre-reading at any time. Once you have finished you may leave early using the button below, or use remaining time to add to your answer.';
    btn.textContent='Finish station';
  }
  fill.style.width='100%';
  tickTimer();
  timerInterval=setInterval(tickTimer,1000);
}

function tickTimer(){
  const m=Math.floor(timeLeft/60);
  const s=timeLeft%60;
  const disp=document.getElementById('timerDigits');
  const fill=document.getElementById('progressFill');
  disp.textContent=m+':'+(s<10?'0':'')+s;
  const pct=Math.max(0,Math.round((timeLeft/totalTime)*100));
  fill.style.width=pct+'%';
  if(timeLeft<=30){disp.className='timer-digits danger';fill.className='progress-fill danger';}
  else if(timeLeft<=60){disp.className='timer-digits warn';fill.className='progress-fill warn';}
  else{disp.className='timer-digits';fill.className='progress-fill '+(phase==='pre'?'reading':'station');}
  if(timeLeft<=0){
    clearInterval(timerInterval);
    if(phase==='pre')setPhase('station');else finishStation();
    return;
  }
  timeLeft--;
}

function handleMainBtn(){
  if(phase==='pre')setPhase('station');else finishStation();
}

function finishStation(){
  if(timerInterval)clearInterval(timerInterval);
  done.add(currentIdx);
  const sc=SCENARIOS[currentIdx];
  const cls=modClass(sc.module);
  document.getElementById('reviewTitle').textContent='Station '+(currentIdx+1)+' — model answer';
  document.getElementById('reviewSub').textContent=sc.title+' · '+sc.module;
  const ms=document.getElementById('modelSections');
  ms.innerHTML='';
  sc.model.forEach(item=>{
    const card=document.createElement('div');
    card.className='model-section';
    card.innerHTML=`<div class="model-heading">${item.h}</div><div class="model-body">${item.b}</div>`;
    ms.appendChild(card);
  });
  const nextIdx=(currentIdx+1)%SCENARIOS.length;
  document.getElementById('nextBtn').textContent='Next: '+SCENARIOS[nextIdx].title.substring(0,40)+'… →';
  document.getElementById('doneBadge').textContent=done.size+' / 13 done';
  showView('reviewView');
}

function nextScenario(){
  startStation((currentIdx+1)%SCENARIOS.length);
}

function goHome(){
  if(timerInterval)clearInterval(timerInterval);
  buildHome();
  showView('homeView');
}

function toggleHints(){
  const hp=document.getElementById('hintsPanel');
  const btn=document.getElementById('hintsToggleBtn');
  const open=hp.style.display==='block';
  hp.style.display=open?'none':'block';
  btn.textContent=open?'Show curriculum pointers ↓':'Hide curriculum pointers ↑';
}

buildFilters();buildHome();
</script>
</body>
